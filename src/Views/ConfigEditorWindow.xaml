<Window x:Class="AIScriptManager.Views.ConfigEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AIScriptManager"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        Title="{x:Static local:Strings.TitleConfigEditor}"
        Width="580" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BrushWindowBg}">
    <DockPanel Margin="16">
        <!-- 底部操作条：左「默认值」一键还原，右「保存 / 取消」 -->
        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button x:Name="BtnReset" Content="{x:Static local:Strings.BtnDefault}"
                    HorizontalAlignment="Left" Width="80" Height="24"
                    Style="{StaticResource BaseButtonLight}" Click="BtnReset_Click" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnSave" Content="{x:Static local:Strings.BtnSave}" Width="80" Height="24"
                        Style="{StaticResource BaseButtonLight}" Click="BtnSave_Click" Margin="0,0,8,0" />
                <Button x:Name="BtnCancel" Content="取消" Width="80" Height="24"
                        Style="{StaticResource BaseButtonLight}" Click="BtnCancel_Click" />
            </StackPanel>
        </Grid>

        <StackPanel>
            <!-- 分区一「工作路径」：脚本索引 / 各目录选择 + 默认超时（均为路径与工作目录相关配置） -->
            <TextBlock Text="{x:Static local:Strings.WorkPathSection}"
                       FontWeight="Bold" Margin="0,0,0,8" />
            <ItemsControl x:Name="Rows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="104" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Label}"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <!-- 与参数列表文件选择框一致：只读输入框 + 右侧「浏览」后缀按钮拼合为一体，只能选不能手输。
                                 外框承载边框与聚焦高亮：聚焦时整框变蓝；右侧无边框（与浏览按钮拼接），故右上/右下为方角。 -->
                            <DockPanel Grid.Column="1" LastChildFill="True">
                                <Button DockPanel.Dock="Right" Style="{StaticResource BaseButtonLightSuffix}"
                                        Width="24" Height="24" Padding="0" Margin="0" VerticalAlignment="Center"
                                        Click="Browse_Click"
                                        ToolTip="{x:Static local:Strings.BrowseButtonToolTip}">
                                    <svgc:SvgViewbox Width="13" Height="13"
                                                     UriSource="{Binding BrowseIconUri}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                                <Border BorderThickness="1,1,0,1" CornerRadius="4,0,0,4"
                                        SnapsToDevicePixels="True" Height="24" VerticalAlignment="Center"
                                        Background="{DynamicResource BrushPanelBg}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
                                            <Style.Triggers>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <!-- ClearableTextBoxInline：边框/背景由外层 Border 绘制，右侧留白给 × 按钮 -->
                                        <TextBox Text="{Binding Value}" IsReadOnly="True"
                                                 Style="{StaticResource ClearableTextBoxInline}" />
                                        <!-- 未自定义（Value 为空）时显示的默认相对路径占位符 -->
                                        <TextBlock Text="{Binding Placeholder}"
                                                   Foreground="{DynamicResource BrushPlaceholder}"
                                                   Margin="4,0,0,0" VerticalAlignment="Center"
                                                   IsHitTestVisible="False"
                                                   Visibility="{Binding Value, Converter={x:Static local:StringEmptyToVisibilityConverter.Instance}}" />
                                        <!-- 清空按钮：仅在已选择（Value 非空）时显示，点 × 回落到默认相对路径 -->
                                        <Button Style="{StaticResource ClearButton}"
                                                Click="Clear_Click"
                                                ToolTip="{x:Static local:Strings.ClearButtonToolTip}"
                                                Visibility="{Binding Value, Converter={x:Static local:StringNotEmptyToVisibilityConverter.Instance}}" />
                                    </Grid>
                                </Border>
                            </DockPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 默认执行超时(秒)：紧跟在「日志目录」下方，允许手输的数字字段；
                 留空即不限制，占位符显示「0（不限制）」，× 清除回落默认。
                 外框为独立方框（四边/四角均圆角），聚焦时整框变蓝。 -->
            <Grid x:Name="TimeoutGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{x:Static local:Strings.ConfigEditorTimeoutLabel}"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <Border Grid.Column="1" BorderThickness="1" CornerRadius="4"
                        Height="24" VerticalAlignment="Center" SnapsToDevicePixels="True"
                        Background="{DynamicResource BrushPanelBg}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
                            <Style.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ClearableTextBoxInline}"
                                 PreviewTextInput="Timeout_PreviewTextInput" />
                        <TextBlock Text="{Binding Placeholder}"
                                   Foreground="{DynamicResource BrushPlaceholder}" Margin="4,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding Value, Converter={x:Static local:StringEmptyToVisibilityConverter.Instance}}" />
                        <Button Style="{StaticResource ClearButton}"
                                Click="TimeoutClear_Click"
                                ToolTip="{x:Static local:Strings.ClearButtonToolTip}"
                                Visibility="{Binding Value, Converter={x:Static local:StringNotEmptyToVisibilityConverter.Instance}}" />
                    </Grid>
                </Border>
            </Grid>

            <!-- AI 生成脚本配置：[ai] 节 api_key / base_url / model / max_rounds。
                 与上方「工作路径」分区不同，这些是纯文本配置，用可手输行（带 × 清空）；
                 API 密钥用 PasswordBox 默认隐藏，勾选「显示」切换为明文 TextBox，避免泄露。 -->
            <TextBlock Text="{x:Static local:Strings.AiConfigSection}"
                       FontWeight="Bold" Margin="0,16,0,8" />

            <!-- API 密钥：PasswordBox（默认隐藏）+ 勾选切换为明文 TextBox（隐藏泄露）。
                 与其它输入框统一：外层 Border 绘制圆角边框 + 聚焦变蓝高亮（IsKeyboardFocusWithin），
                 内部 PasswordBox / TextBox 去边框、透明底。「显示/隐藏」切换按钮（PasswordRevealToggle）
                 内嵌于输入框右侧，等同文件上传式的框内图标按钮；右内边距 24 给该按钮留位。 -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{x:Static local:Strings.AiApiKeyLabel}"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <Border Grid.Column="1" BorderThickness="1" CornerRadius="4"
                        Height="24" VerticalAlignment="Center" SnapsToDevicePixels="True"
                        Background="{DynamicResource BrushPanelBg}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
                            <Style.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <!-- 右内边距 24：给右侧内嵌的显示/隐藏切换按钮留位，长密钥在按钮左侧被裁剪 -->
                        <PasswordBox x:Name="AiApiKeyBox" VerticalAlignment="Center"
                                     Style="{StaticResource ClearablePasswordBoxInline}" Padding="1,0,24,0"
                                     PasswordChanged="AiApiKeyBox_PasswordChanged"
                                     Visibility="{Binding IsChecked, ElementName=AiApiKeyReveal, Converter={x:Static local:InverseBoolToVisibilityConverter.Instance}}" />
                        <TextBox x:Name="AiApiKeyTextBox" VerticalAlignment="Center"
                                 Style="{StaticResource ClearableTextBoxInline}" Padding="1,0,24,0"
                                 TextChanged="AiApiKeyTextBox_TextChanged"
                                 Visibility="{Binding IsChecked, ElementName=AiApiKeyReveal, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}" />
                        <!-- 显示/隐藏切换：内嵌于输入框右侧的图标按钮（眼睛 ↔ 眼睛划线），点击在 PasswordBox / TextBox 间切换 -->
                        <CheckBox x:Name="AiApiKeyReveal" Style="{StaticResource PasswordRevealToggle}"
                                  Checked="AiApiKeyReveal_Changed" Unchecked="AiApiKeyReveal_Changed" />
                    </Grid>
                </Border>
            </Grid>

            <!-- API 地址 / 模型：可手输文本行（带 × 清空 + 占位符） -->
            <ItemsControl x:Name="AiRows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="104" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Label}"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Border Grid.Column="1" BorderThickness="1" CornerRadius="4"
                                    Height="24" VerticalAlignment="Center" SnapsToDevicePixels="True"
                                    Background="{DynamicResource BrushPanelBg}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
                                        <Style.Triggers>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ClearableTextBoxInline}" />
                                    <TextBlock Text="{Binding Placeholder}"
                                               Foreground="{DynamicResource BrushPlaceholder}"
                                               Margin="4,0,0,0" VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Visibility="{Binding Value, Converter={x:Static local:StringEmptyToVisibilityConverter.Instance}}" />
                                    <Button Style="{StaticResource ClearButton}"
                                            Click="AiTextClear_Click"
                                            ToolTip="{x:Static local:Strings.ClearButtonToolTip}"
                                            Visibility="{Binding Value, Converter={x:Static local:StringNotEmptyToVisibilityConverter.Instance}}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 最大追问轮次：一次编辑会话中、首轮生成之外允许的追问轮数，留空 = 默认 0（不追问）。
                 数字手输（拦截非数字），× 清除回落默认；样式与「默认执行超时」一致。 -->
            <Grid x:Name="AiMaxRoundsGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{x:Static local:Strings.AiMaxRoundsLabel}"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <Border Grid.Column="1" BorderThickness="1" CornerRadius="4"
                        Height="24" VerticalAlignment="Center" SnapsToDevicePixels="True"
                        Background="{DynamicResource BrushPanelBg}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
                            <Style.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ClearableTextBoxInline}"
                                 PreviewTextInput="Timeout_PreviewTextInput" />
                        <TextBlock Text="{Binding Placeholder}"
                                   Foreground="{DynamicResource BrushPlaceholder}" Margin="4,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding Value, Converter={x:Static local:StringEmptyToVisibilityConverter.Instance}}" />
                        <Button Style="{StaticResource ClearButton}"
                                Click="AiMaxRoundsClear_Click"
                                ToolTip="{x:Static local:Strings.ClearButtonToolTip}"
                                Visibility="{Binding Value, Converter={x:Static local:StringNotEmptyToVisibilityConverter.Instance}}" />
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </DockPanel>
</Window>
