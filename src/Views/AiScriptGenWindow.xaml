<Window x:Class="ScriptManager.Views.AiScriptGenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScriptManager"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        Title="{x:Static local:Strings.TitleAiGenerate}"
        Width="760" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BrushWindowBg}">
    <DockPanel Margin="16">
        <!-- 底部操作条：右「接受并写入」 -->
        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button x:Name="BtnAccept" Content="{x:Static local:Strings.BtnAiAccept}"
                    HorizontalAlignment="Right" Width="140" Height="30"
                    Style="{StaticResource BaseButtonLight}" Click="BtnAccept_Click" IsEnabled="False" />
        </Grid>

        <StackPanel>
            <!-- 脚本功能描述：语言与参数都在描述里一并说明，无需单独选择（编辑模式下由代码-behind 换成「修改要求」文案） -->
            <TextBlock x:Name="DescLabel" Text="{x:Static local:Strings.AiGenDescLabel}" Margin="0,0,0,4" />
            <Grid>
                <TextBox x:Name="DescBox" Height="120" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                         Padding="6,5" Style="{StaticResource BaseTextBox}" />
                <TextBlock x:Name="DescPlaceholder" Text="{x:Static local:Strings.AiGenDescPlaceholder}"
                           Foreground="{DynamicResource BrushPlaceholder}"
                           Margin="9,8,9,8" TextWrapping="Wrap" IsHitTestVisible="False"
                           Visibility="{Binding Text, ElementName=DescBox, Converter={x:Static local:StringEmptyToVisibilityConverter.Instance}}" />
            </Grid>

            <!-- 生成按钮 + 状态 -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnGenerate" Content="{x:Static local:Strings.BtnAiGenerate}"
                        Width="120" Height="30" Style="{StaticResource BaseButtonLight}" Click="BtnGenerate_Click" />
                <TextBlock x:Name="StatusText" Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"
                           TextWrapping="Wrap" Foreground="{DynamicResource BrushPlaceholder}" />
            </Grid>

            <!-- 脚本预览 -->
            <TextBlock Text="{x:Static local:Strings.AiGenPreviewScript}" Margin="0,16,0,4" FontWeight="Bold" />
            <TextBox x:Name="ScriptPreview" Height="220" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                     VerticalContentAlignment="Top"
                     Style="{StaticResource BaseTextBox}"
                     Background="{DynamicResource BrushEditorBg}" Foreground="{DynamicResource BrushEditorFg}" />

            <!-- 索引条目预览 -->
            <TextBlock Text="{x:Static local:Strings.AiGenPreviewIndex}" Margin="0,12,0,4" FontWeight="Bold" />
            <TextBox x:Name="IndexPreview" Height="130" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                     VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                     VerticalContentAlignment="Top"
                     Style="{StaticResource BaseTextBox}"
                     Background="{DynamicResource BrushEditorBg}" Foreground="{DynamicResource BrushEditorFg}" />
        </StackPanel>
    </DockPanel>
</Window>
