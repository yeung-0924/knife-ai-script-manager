<Window x:Class="AIScriptManager.Views.AiScriptGenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AIScriptManager"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        Title="{x:Static local:Strings.TitleAiGenerate}"
        Width="760" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BrushWindowBg}">
    <DockPanel Margin="16">
        <!-- 底部操作条：右「接受并写入」 -->
        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button x:Name="BtnAccept" Content="{x:Static local:Strings.BtnAiAccept}"
                    HorizontalAlignment="Right" Width="140" Height="30"
                    Style="{StaticResource BaseButtonLight}" Click="BtnAccept_Click" IsEnabled="False" />
        </Grid>

        <StackPanel>
            <!-- 脚本名称：仅由用户手动填写（必填）——AI 不参与取名（system prompt 已禁止模型返回 name 字段，
                 解析时也一律忽略）。编辑模式由代码-behind 预填现有名称，用户可直接改；
                 TextChanged 仅用于刷新「接受并写入」可用性与必填提示，不再有 AI 回填。 -->
            <TextBlock x:Name="NameLabel" Text="{x:Static local:Strings.AiGenNameLabel}" Margin="0,0,0,4" FontWeight="Bold" />
            <Grid>
                <TextBox x:Name="NameBox" Height="32" Padding="6,7" Style="{StaticResource BaseTextBox}" TextChanged="NameBox_TextChanged" />
                <TextBlock x:Name="NamePlaceholder" Text="{x:Static local:Strings.AiGenNamePlaceholder}"
                           Foreground="{DynamicResource BrushPlaceholder}"
                           Margin="9,8,9,8" TextWrapping="Wrap" IsHitTestVisible="False"
                           Visibility="{Binding Text, ElementName=NameBox, Converter={x:Static local:StringEmptyToVisibilityConverter.Instance}}" />
            </Grid>
            <!-- 脚本功能描述：语言与参数都在描述里一并说明，无需单独选择（编辑模式下由代码-behind 换成「修改要求」文案） -->
            <TextBlock x:Name="DescLabel" Text="{x:Static local:Strings.AiGenDescLabel}" Margin="0,0,0,4" FontWeight="Bold" />
            <Grid>
                <!-- Padding 6,7：文本真实落点 = Padding + TextBoxView 内缩(左3/上1) = (9,8)，
                     与占位符 Margin(9,8,9,8) 精确对齐（占位符消失→正文显示，位置不跳动） -->
                <TextBox x:Name="DescBox" Height="120" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                         Padding="6,7" Style="{StaticResource BaseTextBox}" />
                <TextBlock x:Name="DescPlaceholder" Text="{x:Static local:Strings.AiGenDescPlaceholder}"
                           Foreground="{DynamicResource BrushPlaceholder}"
                           Margin="9,8,9,8" TextWrapping="Wrap" IsHitTestVisible="False"
                           Visibility="{Binding Text, ElementName=DescBox, Converter={x:Static local:StringEmptyToVisibilityConverter.Instance}}" />
            </Grid>

            <!-- 生成按钮 + 状态 -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnGenerate" Content="{x:Static local:Strings.BtnAiGenerate}"
                        Width="120" Height="30" Style="{StaticResource BaseButtonLight}" Click="BtnGenerate_Click" />
                <TextBlock x:Name="StatusText" Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"
                           TextWrapping="Wrap" Foreground="{DynamicResource BrushPlaceholder}" />
            </Grid>

            <!-- 脚本预览：生成中此标题临时切换为「模型实时回复」，完成后恢复并显示解析结果
                 （索引条目不预览——条目由程序按 id 自动维护，非用户关心内容） -->
            <TextBlock x:Name="PreviewScriptLabel" Text="{x:Static local:Strings.AiGenPreviewScript}" Margin="0,16,0,4" FontWeight="Bold" />
            <TextBox x:Name="ScriptPreview" Height="220" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                     VerticalContentAlignment="Top"
                     Style="{StaticResource BaseTextBox}"
                     Background="{DynamicResource BrushEditorBg}" Foreground="{DynamicResource BrushEditorFg}" />
        </StackPanel>
    </DockPanel>
</Window>
